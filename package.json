{
  "name": "local-rag-codebase",
  "version": "0.1.0",
  "type": "module",
  "bin": { "rag": "./dist/index.js" },
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm --dts --clean",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src eval"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^9.0.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "ignore": "^5.3.0",
    "ollama": "^0.5.0",
    "tree-sitter-wasms": "^0.1.0",
    "web-tree-sitter": "^0.22.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
