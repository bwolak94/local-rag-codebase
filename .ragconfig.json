{
  "root": ".",
  "include": ["src/**", "apps/**", "packages/**"],
  "exclude": [
    "**/*.generated.*",
    "**/__generated__/**",
    "**/*.min.*",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "maxFileBytes": 200000,
  "embedding": {
    "model": "nomic-embed-text",
    "batchSize": 48
  },
  "llm": {
    "model": "qwen2.5-coder:14b",
    "numCtx": 32768,
    "temperature": 0.1,
    "rewriteTemperature": 0.3
  },
  "retrieval": {
    "kVector": 20,
    "kFts": 20,
    "kFinal": 8,
    "expandDepth": 1,
    "rewrite": false,
    "rerank": "none"
  },
  "store": {
    "driver": "lancedb",
    "path": ".rag"
  },
  "budget": {
    "contextFraction": 0.60,
    "historyFraction": 0.20
  }
}
